{
  "$defs": {
    "fieldDescriptor": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/fieldDescriptor"
          },
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "null",
            "record"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "typedValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "record"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/typedValue"
              },
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$",
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://github.com/David-Lee-11101/SmartHome-Edge-Computing-System/contracts/schemas/v1/scheduling-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actionNotBefore": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "proceed",
        "reorder",
        "defer",
        "abstain"
      ]
    },
    "decisionId": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "persistedAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "planId": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "profileEvidenceId": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "reason": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "resolvedOrder": {
      "items": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "schemaVersion": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "decisionId",
    "planId",
    "profileEvidenceId",
    "decision",
    "reason",
    "resolvedOrder",
    "persistedAt",
    "actionNotBefore"
  ],
  "title": "SchedulingDecision",
  "type": "object"
}
