{
  "$defs": {
    "fieldDescriptor": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/fieldDescriptor"
          },
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "null",
            "record"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "typedValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "record"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/typedValue"
              },
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$",
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://github.com/David-Lee-11101/SmartHome-Edge-Computing-System/contracts/schemas/v1/schedule-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conditions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "conditionId": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
            "type": "string"
          },
          "expected": {
            "$ref": "#/$defs/typedValue"
          },
          "nodeId": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
            "type": "string"
          }
        },
        "required": [
          "conditionId",
          "nodeId",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "deadlineEpochMs": {
      "minimum": 1,
      "type": "integer"
    },
    "planId": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "additionalProperties": false,
            "properties": {
              "arguments": {
                "items": {
                  "$ref": "#/$defs/typedValue"
                },
                "minItems": 0,
                "type": "array"
              },
              "operation": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
                "type": "string"
              },
              "serviceId": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
                "type": "string"
              }
            },
            "required": [
              "serviceId",
              "operation",
              "arguments"
            ],
            "type": "object"
          },
          "dependencies": {
            "items": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
              "type": "string"
            },
            "minItems": 0,
            "type": "array"
          },
          "readResources": {
            "items": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
              "type": "string"
            },
            "minItems": 0,
            "type": "array"
          },
          "taskId": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
            "type": "string"
          },
          "writeResources": {
            "items": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
              "type": "string"
            },
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "taskId",
          "dependencies",
          "readResources",
          "writeResources",
          "action"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "tasks",
    "conditions",
    "deadlineEpochMs"
  ],
  "title": "SchedulePlan",
  "type": "object"
}
