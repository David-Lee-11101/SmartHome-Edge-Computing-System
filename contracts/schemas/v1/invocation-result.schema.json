{
  "$defs": {
    "fieldDescriptor": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/fieldDescriptor"
          },
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$",
          "type": "string"
        },
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "null",
            "record"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "typedValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "null"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "record"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/typedValue"
              },
              "maxProperties": 32,
              "propertyNames": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$",
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://github.com/David-Lee-11101/SmartHome-Edge-Computing-System/contracts/schemas/v1/invocation-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completedAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "durationMs": {
      "minimum": 0,
      "type": "integer"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "requestId": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{2,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "error",
        "timeout",
        "cancelled"
      ]
    },
    "value": {
      "$ref": "#/$defs/typedValue"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "completedAt",
    "durationMs"
  ],
  "title": "InvocationResult",
  "type": "object"
}
